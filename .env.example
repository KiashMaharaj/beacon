# Beacon environment configuration
# Copy to .env.local and fill in. The app runs in demo mode (seeded local data)
# when Supabase variables are absent, so you can explore the full UI without a backend.

# --- Supabase (optional for demo, required for production) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, used by migrations/admin scripts. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Maps ---
# Public map tile / geocoding provider key (e.g. MapTiler, Mapbox). Optional in demo mode.
NEXT_PUBLIC_MAP_TILE_KEY=

# --- Firebase Cloud Messaging (push notification architecture) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Server-only FCM admin credentials (base64-encoded service account JSON).
FCM_SERVICE_ACCOUNT_BASE64=
