# Beacon environment configuration
# Copy to .env.local and fill in. The app runs in demo mode (seeded local data)
# when Supabase variables are absent, so you can explore the full UI without a backend.

# --- Supabase (optional for demo, required for production) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, used by migrations/admin scripts. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Maps & geocoding ---
# Beacon uses real interactive maps out of the box with NO API key:
#   tiles      -> CARTO basemaps (light + dark) over OpenStreetMap data
#   geocoding  -> OpenStreetMap Nominatim (type-to-search + reverse geocode)
# Everything below is OPTIONAL. Override only to use your own provider or a
# self-hosted geocoder for higher rate limits in production.
# Tile URL templates ({z}/{x}/{y}); the {r} token enables retina tiles.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_URL_DARK=
# Geocoder base URL (defaults to https://nominatim.openstreetmap.org).
NEXT_PUBLIC_GEOCODER_URL=

# --- Firebase Cloud Messaging (push notifications) ---
# All of these are PUBLIC Firebase web config values (safe in the client bundle).
# From Firebase console -> Project settings -> General -> Your apps (Web app).
# Push stays off until these are set; the rest of the app is unaffected.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web Push certificate key pair (Cloud Messaging -> Web configuration).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
#
# The SENDER (Supabase Edge Function) uses a service account. These are set as
# Supabase function secrets, NOT in this file / the client:
#   FCM_SERVICE_ACCOUNT   full service-account JSON (one line)
#   see PUSH_SETUP.md
